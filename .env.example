# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ห้าม commit)
PORT=5000

# SQL Server — บังคับต้องมี ระบบจะไม่ใช้ค่าสำรองในโค้ดแล้ว
DB_USER=
DB_PASSWORD=
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=LMS

# Secret สำหรับเซ็น token ตอน login — สุ่มยาวอย่างน้อย 32 ตัวอักษร ห้ามเปิดเผย
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ถ้าไม่ตั้ง ระบบจะสุ่มให้ทุกครั้งที่ start (ทุกคนต้อง login ใหม่หลัง restart)
JWT_SECRET=
# ⓘ ค่านี้ใช้แค่ตอนสร้างตาราง Setting ครั้งแรก — หลังจากนั้นแก้ที่ตาราง Setting ในฐานข้อมูล (มีผลภายใน 1 นาที ไม่ต้อง restart)
# อายุของ token (เช่น 12h, 8h, 30m) — หมดอายุแล้วต้อง login ใหม่
JWT_EXPIRES_IN=12h

# enforce = บล็อกคำขอที่ไม่มีสิทธิ์ (ค่าเริ่มต้น)
# report  = ไม่บล็อก แค่ log ว่าจะถูกปฏิเสธ (ใช้ช่วงทดลองระบบ)
PERMISSION_MODE=enforce

# โดเมนของหน้าเว็บที่อนุญาตให้เรียก API (คั่นด้วยจุลภาค)
# ใส่ origin ที่ผู้ใช้เปิดหน้าเว็บจริง เช่น http://192.168.1.50:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- SQL Server: การเชื่อมต่อ ----------
# ชื่อ instance (ค่าเริ่มต้น SQLEXPRESS) — ตั้งเป็นค่าว่าง (DB_INSTANCE=) เพื่อใช้ DB_PORT แทน
DB_INSTANCE=SQLEXPRESS
# true = เข้ารหัสการเชื่อมต่อกับ SQL Server (แนะนำ)
DB_ENCRYPT=false
# true = ยอมรับ certificate ที่ SQL Server สร้างเอง (self-signed)
DB_TRUST_SERVER_CERT=true

# ---------- HTTPS ----------
# ใส่ path ไฟล์ key และ certificate เพื่อเปิด HTTPS (ไม่ตั้ง = HTTP)
SSL_KEY_FILE=
SSL_CERT_FILE=

# ---------- Login ----------
# ความยาวรหัสผ่านขั้นต่ำตอนสร้าง/เปลี่ยนรหัส (ต่ำสุด 8)
PASSWORD_MIN_LENGTH=8
# ⓘ ค่านี้ใช้แค่ตอนสร้างตาราง Setting ครั้งแรก — หลังจากนั้นแก้ที่ตาราง Setting ในฐานข้อมูล (มีผลภายใน 1 นาที ไม่ต้อง restart)
# ล็อคบัญชี (เก็บในฐานข้อมูล): กรอกรหัสผ่านผิดติดกันกี่ครั้งถึงล็อค และล็อคกี่นาที
ACCOUNT_LOCKOUT_MAX_FAILS=5
ACCOUNT_LOCKOUT_MINUTES=30
# ⓘ ค่านี้ใช้แค่ตอนสร้างตาราง Setting ครั้งแรก — หลังจากนั้นแก้ที่ตาราง Setting ในฐานข้อมูล (มีผลภายใน 1 นาที ไม่ต้อง restart)
# จำกัดต่อ IP: login ผิดเกินกี่ครั้งต่อ IP ถึงบล็อค IP นั้น และบล็อคกี่นาที
LOGIN_MAX_FAILS_PER_IP=20
LOGIN_LOCK_MINUTES=15

# ---------- MFA (รหัส 6 หลักจากแอป Authenticator) ----------
# key เข้ารหัส secret ของ MFA — บังคับต้องมี (base64 ยาว 32 byte) และต้องไม่ซ้ำกับ JWT_SECRET
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ห้ามเปลี่ยนหลังใช้งานจริง ไม่อย่างนั้นทุกคนต้องผูก MFA ใหม่
MFA_ENCRYPTION_KEY=
# ชื่อที่แสดงในแอป Authenticator
MFA_ISSUER=LMS Wan Thai Foods
# ⓘ ค่านี้ใช้แค่ตอนสร้างตาราง Setting ครั้งแรก — หลังจากนั้นแก้ที่ตาราง Setting ในฐานข้อมูล (มีผลภายใน 1 นาที ไม่ต้อง restart)
# กรอกรหัส MFA ผิดกี่ครั้งถึงล็อค และล็อคกี่นาที
MFA_MAX_FAILS=5
MFA_LOCK_MINUTES=15
# ⓘ ค่านี้ใช้แค่ตอนสร้างตาราง Setting ครั้งแรก — หลังจากนั้นแก้ที่ตาราง Setting ในฐานข้อมูล (มีผลภายใน 1 นาที ไม่ต้อง restart)
# เวลาที่ให้กรอกรหัส MFA หลังกรอกรหัสผ่านถูก (นาที)
MFA_PENDING_MINUTES=5
# ⓘ ค่านี้ใช้แค่ตอนสร้างตาราง Setting ครั้งแรก — หลังจากนั้นแก้ที่ตาราง Setting ในฐานข้อมูล (มีผลภายใน 1 นาที ไม่ต้อง restart)
# อายุลิงก์เปิดใช้งานบัญชี / ผูก MFA ใหม่ในอีเมล (ชั่วโมง)
ACCOUNT_SETUP_LINK_HOURS=24

# ---------- Email (SMTP) ----------
# ใช้ส่งอีเมลตั้งรหัสผ่านใหม่ (Resend: host smtp.resend.com, user resend, pass = API key)
# ห้ามใส่ API key ลงในโค้ด ให้ใส่ใน .env เท่านั้น
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# ผู้ส่ง ต้องเป็นโดเมนที่ยืนยันใน Resend แล้ว เช่น LMS <no-reply@yourdomain.com>
# (onboarding@resend.dev ใช้ทดสอบได้ แต่ส่งได้เฉพาะอีเมลเจ้าของบัญชี Resend)
MAIL_FROM=
# URL หน้าเว็บที่ผู้ใช้เปิด ใช้สร้างลิงก์ในอีเมล (ไม่ตั้ง = ใช้ค่าแรกของ CORS_ORIGINS)
APP_PUBLIC_URL=
# ⓘ ค่านี้ใช้แค่ตอนสร้างตาราง Setting ครั้งแรก — หลังจากนั้นแก้ที่ตาราง Setting ในฐานข้อมูล (มีผลภายใน 1 นาที ไม่ต้อง restart)
# ลิงก์ตั้งรหัสผ่านใหม่หมดอายุกี่นาที (5-1440)
PASSWORD_RESET_EXPIRES_MINUTES=15
# ⓘ ค่านี้ใช้แค่ตอนสร้างตาราง Setting ครั้งแรก — หลังจากนั้นแก้ที่ตาราง Setting ในฐานข้อมูล (มีผลภายใน 1 นาที ไม่ต้อง restart)
# ลองยืนยันลิงก์ผิดเกินกี่ครั้งต่อ IP ถึงล็อค (ล็อคนาน LOGIN_LOCK_MINUTES)
PASSWORD_RESET_MAX_FAILS_PER_IP=10

# ระดับ log ของ backend: debug | info | warn | error (ค่าเริ่มต้น: production = info, อื่นๆ = debug)
# ไม่เกี่ยวกับ Audit log (ประวัติการบันทึก) ซึ่งบันทึกลงฐานข้อมูลเสมอ
LOG_LEVEL=info
